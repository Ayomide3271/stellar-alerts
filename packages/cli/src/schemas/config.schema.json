{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StellarAlertsProfilesConfig",
  "description": "JSON Schema v7 for Stellar Alerts CLI profile configuration files",
  "type": "object",
  "required": ["version", "activeProfile", "profiles"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "enum": [1],
      "description": "Schema version indicator for future migrations"
    },
    "activeProfile": {
      "type": ["string", "null"],
      "description": "Currently active profile name, or null if none active"
    },
    "profiles": {
      "type": "object",
      "description": "Map of profile names to profile configurations",
      "propertyNames": {
        "pattern": "^[a-zA-Z0-9_-]{1,64}$"
      },
      "additionalProperties": {
        "type": "object",
        "required": ["name", "apiUrl", "createdAt", "updatedAt", "hasSecrets"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,64}$"
          },
          "network": {
            "type": "string",
            "description": "Stellar network hint (testnet, mainnet, staging, etc.)"
          },
          "apiUrl": {
            "type": "string",
            "format": "uri",
            "description": "REST API base URL"
          },
          "logLevel": {
            "type": "string",
            "enum": ["debug", "info", "warn", "error"]
          },
          "createdAt": {
            "type": "string",
            "description": "ISO-8601 creation timestamp"
          },
          "updatedAt": {
            "type": "string",
            "description": "ISO-8601 last update timestamp"
          },
          "hasSecrets": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
