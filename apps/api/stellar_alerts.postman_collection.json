{
  "info": {
    "_postman_id": "86901d8d-960e-4ad2-b80c-b56cd9c59dc7",
    "name": "Stellar Alerts API",
    "description": "Complete Postman collection for testing all endpoints in the Stellar Alerts API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Check if API server is running."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Request Magic Link",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/request-link",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "request-link"
              ]
            },
            "description": "Request a magic login link for an email address."
          },
          "response": []
        },
        {
          "name": "Verify Magic Link",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set(\"token\", jsonData.token);",
                  "    console.log(\"Saved session token to variable:\", jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/verify?token={{magicToken}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "verify"
              ],
              "query": [
                {
                  "key": "token",
                  "value": "{{magicToken}}",
                  "description": "JWT token received from console logs or email"
                }
              ]
            },
            "description": "Verify magic link token and obtain session JWT token."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Wallets",
      "item": [
        {
          "name": "Add Wallet",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.wallet && jsonData.wallet.id) {",
                  "    pm.collectionVariables.set(\"walletId\", jsonData.wallet.id);",
                  "    console.log(\"Saved walletId to variable:\", jsonData.wallet.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"publicKey\": \"GDX3I6LJUZNVV7UZVGXFNFXSWD7MTQ2KQ2UTRKQUOGKQUR2TQY6BBLLR\",\n  \"label\": \"Main Trading Wallet\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/wallets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "wallets"
              ]
            },
            "description": "Add a new Stellar wallet to track (Requires Auth)."
          },
          "response": []
        },
        {
          "name": "Get Wallets",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/wallets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "wallets"
              ]
            },
            "description": "Get all tracked wallets for the logged in user (Requires Auth)."
          },
          "response": []
        },
        {
          "name": "Delete Wallet",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/wallets/{{walletId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "wallets",
                "{{walletId}}"
              ]
            },
            "description": "Delete a tracked wallet by ID (Requires Auth)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "Get Payments",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/payments?walletId={{walletId}}&limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments"
              ],
              "query": [
                {
                  "key": "walletId",
                  "value": "{{walletId}}"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            },
            "description": "Get payments for a specific wallet."
          },
          "response": []
        },
        {
          "name": "Get Payments Summary",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/payments/summary?walletId={{walletId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments",
                "summary"
              ],
              "query": [
                {
                  "key": "walletId",
                  "value": "{{walletId}}"
                }
              ]
            },
            "description": "Get payment summary and statistics for a specific wallet."
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001",
      "type": "string"
    },
    {
      "key": "magicToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "walletId",
      "value": "",
      "type": "string"
    }
  ]
}
