{
  "name": "api",
  "version": "1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "build": "node init && tsc",
    "typecheck": "tsc --noEmit",
    "dev": "node init && tsx watch --env-file=.env src/server.ts",
    "dev:worker": "node init && tsx watch --env-file=.env src/workers/watcher.worker.ts",
    "dev:indexer": "node init && tsx watch --env-file=.env src/workers/soroban-indexer.worker.ts",
    "indexer:benchmark": "tsx --env-file=.env src/workers/soroban-indexer.worker.ts benchmark",
    "dev:exports": "node init && tsx watch --env-file=.env src/workers/export.worker.ts",
    "dev:supervisor": "node init && tsx --env-file=.env src/workers/supervisor.ts",
    "dev:checksum-worker": "node init && tsx watch --env-file=.env src/workers/checksum-chain.worker.ts",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:integration": "vitest run --run --no-file-parallelism --exclude \"src/**/!(*.integration).test.ts\"",
    "test:unit": "vitest run --run --exclude \"**/*.integration.test.ts\" --exclude \"src/testing/__tests__/**\"",
    "test:fixtures": "vitest run --config vitest.integration.config.ts --run",
    "test:fuzz": "vitest run src/utils/__tests__/webhook-fuzzer.test.ts",
    "test:e2e": "vitest run src/__tests_/e2e.test.ts",
    "test:coverage": "vitest run --coverage",
    "test:webhooks": "vitest -c ./vitest.config.ts apps/api/src/modules/webhooks/__tests__ --run",
    "cli:tui": "tsx --env-file=.env src/cli/tui-dashboard.tsx",
    "daemon:start": "tsx --env-file=.env src/cli/daemon.ts start",
    "daemon:install:systemd": "tsx src/cli/daemon.ts install:systemd",
    "daemon:install:launchd": "tsx src/cli/daemon.ts install:launchd"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.1",
    "@types/node-cron": "^3.0.11",
    "@types/opossum": "^8.1.9",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/snarkjs": "^0.7.9",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^3.2.7",
    "c12": "^3.1.0",
    "fast-check": "^3.23.2",
    "form-data": "^4.0.6",
    "pathe": "^2.0.3",
    "pkg-types": "^2.3.1",
    "prisma": "^7.9.0",
    "supertest": "^7.3.0",
    "toxiproxy-node-client": "^4.1.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "unpkg": "^0.2.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@apollo/server": "^4.13.0",
    "@as-integrations/fastify": "^3.1.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/websocket": "^11.3.1",
    "@grpc/grpc-js": "^1.12.0",
    "@grpc/proto-loader": "^0.7.13",
    "@opentelemetry/api": "^1.1.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/instrumentation": "^0.221.0",
    "@opentelemetry/instrumentation-http": "^0.221.0",
    "@opentelemetry/resources": "^1.1.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.1.0",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@prisma/instrumentation": "^7.10.0",
    "@stellar-alerts/shared": "*",
    "bullmq": "^5.41.6",
    "commander": "^13.0.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.10.0",
    "fastify-plugin": "^6.0.0",
    "graphql": "^16.10.0",
    "graphql-subscriptions": "^2.0.0",
    "handlebars": "^4.7.9",
    "ioredis": "^6.0.0",
    "ink": "^5.0.0",
    "ink-table": "^3.1.0",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.6.0",
    "opossum": "^10.0.0",
    "otplib": "^12.0.1",
    "pdfkit": "^0.20.1",
    "pg": "^8.22.0",
    "pure-rand": "^8.4.2",
    "qrcode": "^1.5.3",
    "react": "^19.0.0",
    "resend": "^3.5.0",
    "snarkjs": "^0.7.6",
    "stellar-sdk": "^13.3.0",
    "zod": "^4.4.3"
  }
}
